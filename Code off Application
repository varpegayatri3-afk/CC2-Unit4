
#include <iostream>   
#include <string>     
#include <iomanip>   
#include <algorithm>  
using namespace std;

// Node structure stores stock details
struct Node {
    int stockID;          
    string stockName;     
    float stockPrice;     
    int height;           
    Node *left, *right;   

    // Constructor: Initialize a new stock node
    Node(int id, string name, float price) {
        stockID = id;
        stockName = name;
        stockPrice = price;
        height = 1;
        left = right = nullptr;
    }
};

// Function: Return height of a node
int height(Node* n) {
    return n ? n->height : 0;
}

// Function: Calculate balance factor
int balanceFactor(Node* n) {
    return n ? height(n->left) - height(n->right) : 0;
}

Node* rightRotate(Node* y) {
    Node* x = y->left;
    Node* t = x->right;

    x->right = y;
    y->left = t;

    y->height = 1 + max(height(y->left), height(y->right));
    x->height = 1 + max(height(x->left), height(x->right));

    return x;
}

Node* leftRotate(Node* x) {
    Node* y = x->right;
    Node* t = y->left;

    y->left = x;
    x->right = t;

    x->height = 1 + max(height(x->left), height(x->right));
    y->height = 1 + max(height(y->left), height(y->right));

    return y;
}

// Function: Insert stock and balance AVL tree
Node* insert(Node* root, int id, string name, float price) {

    if (root == nullptr)
        return new Node(id, name, price);

    if (id < root->stockID)
        root->left = insert(root->left, id, name, price);
    else if (id > root->stockID)
        root->right = insert(root->right, id, name, price);
    else {
        cout << "Stock ID already exists!\n";
        return root;
    }

    root->height = 1 + max(height(root->left), height(root->right));

    int b = balanceFactor(root);

    if (b > 1 && id < root->left->stockID)
        return rightRotate(root);

    if (b < -1 && id > root->right->stockID)
        return leftRotate(root);

    if (b > 1 && id > root->left->stockID) {
        root->left = leftRotate(root->left);
        return rightRotate(root);
    }

    if (b < -1 && id < root->right->stockID) {
        root->right = rightRotate(root->right);
        return leftRotate(root);
    }


    return root;
}

// Function: Display AVL tree sideways
void displaySideways(Node* root, int space = 0) {
    if (root == nullptr)
        return;
    space += 8;

    displaySideways(root->right, space);

    cout << endl;

    for (int i = 10; i < space; i++)
        cout << " ";

    // Display Stock ID, Name and Price
    cout << root->stockID << " - "
         << root->stockName << " - Rs."
         << fixed << setprecision(2)
         << root->stockPrice << endl;

    displaySideways(root->left, space);
}

// Function: Display all stocks in ascending ID order
void displayAll(Node* root) {
    if (root == nullptr)
        return;

    // Visit left subtree
    displayAll(root->left);

    // Display current stock details
    cout << left << setw(12) << root->stockID
         << setw(18) << root->stockName
         << "Rs. " << fixed << setprecision(2)
         << root->stockPrice << endl;

    // Visit right subtree
    displayAll(root->right);
}

// Function: Search stock using Stock ID
Node* search(Node* root, int id) {

    if (root == nullptr || root->stockID == id)
        return root;

    if (id < root->stockID)
        return search(root->left, id);

    return search(root->right, id);
}

// Main function: Control the application
int main() {
    Node* root = nullptr;  // Initially empty AVL tree
    int choice, id;
    string name;
    float price;

    // Repeat menu until user selects Exit
    do {
        cout << "\n===== STOCK TICKER APPLICATION =====\n";
        cout << "1. Insert Stock\n";
        cout << "2. Display AVL Tree Sideways\n";
        cout << "3. Display All Stocks\n";
        cout << "4. Search Stock by ID\n";
        cout << "5. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
        
            cout << "Enter Stock ID: ";
            cin >> id;

            cout << "Enter Stock Name (one word): ";
            cin >> name;

            cout << "Enter Stock Price (Rs.): ";
            cin >> price;

        
            if (!cin || price < 0) {
                cout << "Invalid stock details!\n";
                return 1;
            }

        
            if (search(root, id) != nullptr) {
                cout << "Stock ID already exists!\n";
            }
            else {
            
                root = insert(root, id, name, price);

            
                cout << "\nAVL Tree after insertion:\n";
                displaySideways(root);
                cout << endl;
            }
            break;

        case 2:
        
            cout << "\nStock ID - Name - Price:\n";
            displaySideways(root);
            cout << endl;
            break;

        case 3:
        
            cout << "\nID          Stock Name        Price\n";
            cout << "--------------------------------------\n";
            displayAll(root);
            break;

        case 4:
        
            cout << "Enter Stock ID to search: ";
            cin >> id;

            {
                Node* found = search(root, id);

                if (found != nullptr) {
                    cout << "Stock ID: " << found->stockID << endl;
                    cout << "Stock Name: " << found->stockName << endl;
                    cout << "Stock Price: Rs. "
                         << fixed << setprecision(2)
                         << found->stockPrice << endl;
                }
                else {
                    cout << "Stock not found!\n";
                }
            }
            break;

        case 5:
            // Exit the application
            cout << "Thank you for using the application!\n";
            break;

        default:
            // Handle invalid menu choice
            cout << "Invalid choice!\n";
        }

    } while (choice != 5);

    return 0; 
}
